{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex project permission control profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "label", "mode", "reason"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "mode": {"enum": ["toggle", "confirm_each", "fixed"]},
          "default": {"enum": ["allow", "deny"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"mode": {"const": "toggle"}}},
            "else": {"not": {"required": ["default"]}}
          }
        ]
      }
    }
  },
  "control_artifact": true,
  "not_evidence": true,
  "not_citation": true,
  "not_answer_support": true
}
